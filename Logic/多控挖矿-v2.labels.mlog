gate:
jump refill greaterThanEq @time cfg.next
hot:
jump gate strictEqual cfg.item null
op add @counter @counter tmp.hp
refill:
op add cfg.next @time 2000
sensor tmp.ic sorter1 @config
jump ic2r strictEqual tmp.ic null
set cfg.item tmp.ic
ic2r:
set tmp.t 0
getlink tmp.lnk 1
jump rf1 strictEqual tmp.lnk null
sensor lx tmp.lnk @x
sensor ly tmp.lnk @y
rf1:
ubind cfg.utype
sensor uty @unit @type
jump hot strictEqual uty null
set tmp.cbk @counter
op mul tmp.p N -2
op add tmp.cbo tmp.cbk 63
op add @counter tmp.cbo tmp.p
chk30:
sensor tmp.c u30 @controller
jump fill30 strictEqual tmp.c null
chk29:
sensor tmp.c u29 @controller
jump fill29 strictEqual tmp.c null
