print "[#ffd166]多控挖矿[] v1 · 30 槽单位多控"
print "By - [blue]DeepSeek[]"
print "半编译产物：硬编码 30 槽，set N 1~30，小逻辑满速"
print "N=8 一圈 3+8*19 = 155 条 = 1.29 s（micro 2 ipt）"
print "ulocate ore 定位 -> approach -> mine，挖满才回投递点"
print "货不对就 drop @air 清仓，改挖新矿"
print "矿种读 sorter1 的 @config（每 2 s 重读），投递 getlink 1"
print "改兵种只改 ubind 一行（必须能挖：poly/mono）"
print "注意：矿点离最近核心 < 27.5 格时引擎会自动把满仓矿倒进核心"

set N 8
ubind @poly
sensor cfg.utype @unit @type
jump 10 strictEqual cfg.utype null
op mul cfg.cap N 2
op add cfg.cap cfg.cap 4
set cfg.next 0
set cfg.nloc 0
set sx @thisx
set sy @thisy
set lx @thisx
set ly @thisy
sensor tmp.ic sorter1 @config
jump 24 strictEqual tmp.ic null
set cfg.item tmp.ic
op min N N 30
op max N N 1
op mul tmp.hp N -19
op sub tmp.hp tmp.hp 3
jump 600 always
ubind u30
sensor tmp.f @unit @firstItem
jump 43 strictEqual tmp.f null
jump 42 notEqual tmp.f cfg.item
sensor tmp.n @unit @totalItems
sensor tmp.c @unit @itemCapacity
jump 43 lessThan tmp.n tmp.c
jump 43 strictEqual tmp.lnk null
ucontrol approach lx ly 6.5 0 0
ucontrol itemDrop tmp.lnk 999 0 0 0
sensor tmp.f @unit @firstItem
jump 43 strictEqual tmp.f null
jump 48 always
ucontrol itemDrop @air 999 0 0 0
ulocate ore core 0 cfg.item ox oy tmp.gm ob
jump 48 strictEqual tmp.gm 0
ucontrol approach ox oy 6.5 0 0
ucontrol mine ox oy 0 0 0
jump 48 always
ubind u29
sensor tmp.f @unit @firstItem
jump 62 strictEqual tmp.f null
