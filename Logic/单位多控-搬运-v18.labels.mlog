refill:
op add cfg.next @time 2000
set tmp.t 0
getlink tmp.lnk 1
jump rf1 strictEqual tmp.lnk null
sensor lx tmp.lnk @x
sensor ly tmp.lnk @y
rf1:
sensor tmp.ic tmp.lnk @config
jump ic1 strictEqual tmp.ic null
set cfg.item tmp.ic
ic1:
ubind cfg.utype
sensor uty @unit @type
jump hot strictEqual uty null
set tmp.cbk @counter
op mul tmp.p N -2
op add tmp.cbo tmp.cbk 61
op add @counter tmp.cbo tmp.p
