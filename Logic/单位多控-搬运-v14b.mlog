# mlogc 生成：mode=haul slots=28 type=@flare refill=2000ms cap=0 source=core live
# 热循环 339 条 -> micro 满载每圈 169.50 tick / 2.825 s
# 全程序 971 条（含补员突发）；micro(2 ipt) 最坏整圈 486 tick / 8.09 s
init:
set N 8
set L 0
boot:
ubind @flare
sensor cfg.utype @unit @type
jump boot strictEqual cfg.utype null
op mul cfg.cap N 2
op add cfg.cap cfg.cap 4
set cfg.next 0
set sx @thisx
set sy @thisy
set lx @thisx
set ly @thisy
set cfg.tgt sorter1
op min N N 28
op max N N 1
set tmp.base @counter
op add tmp.off tmp.base 339
