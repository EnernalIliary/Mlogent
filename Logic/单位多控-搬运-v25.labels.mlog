# mlogc 生成：mode=haul slots=28 type=@poly refill=2000ms cap=0 source=core
# 热循环 620 条 -> micro 满载每圈 310.00 tick / 5.167 s
# 全程序 983 条（含补员突发）；micro(2 ipt) 最坏整圈 492 tick / 8.19 s
init:
set N 8
boot:
ubind @poly
sensor cfg.utype @unit @type
jump boot strictEqual cfg.utype null
op mul cfg.cap N 2
op add cfg.cap cfg.cap 4
set cfg.next 0
set cfg.nloc 0
set tmp.needloc 1
set sx @thisx
set sy @thisy
set lx @thisx
set ly @thisy
set cfg.tgt 1
op min N N 28
op max N N 1
set tmp.base @counter
op add tmp.off tmp.base 620
hot:
jump gate strictEqual cfg.item null
op mul tmp.p N -22
op add @counter tmp.off tmp.p
u28:
ubind u28
sensor tmp.f @unit @firstItem
jump u28d notEqual tmp.f null
ucontrol approach sx sy 6.5 0 0
ulocate building storage 0 0 vx vy tmp.g2 vault
jump u28k equal vault tmp.lnk
ucontrol itemTake vault cfg.item 999 0 0
u28k:
ucontrol itemTake st cfg.item 999 0 0
sensor tmp.f @unit @firstItem
jump u28e strictEqual tmp.f null
ucontrol approach lx ly 6.5 0 0
jump u28e always
u28d:
jump u28j notEqual tmp.f cfg.item
ucontrol approach lx ly 6.5 0 0
ucontrol itemDrop tmp.lnk 999 0 0 0
sensor tmp.f @unit @firstItem
jump u28e notEqual tmp.f null
set tmp.needloc 1
ucontrol approach sx sy 6.5 0 0
jump u28e always
u28j:
ucontrol approach cbx cby 6.5 0 0
ucontrol itemDrop cbc 999 0 0 0
u28e:
