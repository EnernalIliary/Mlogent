print "[#ffd166]类型键表多控[] v1 · 每类型一行"
print "By DeepSeek"
print "表行=单位类型，键=@type 的 @name（运行时字符串），值=该类型最近服务的单位"
print "同类型多只靠 ubind <类型> 环形游标轮流，代码量只随类型数增长，不随单位数"
print "槽名用 set 声明，@this 只写已存在的变量（LogicBlock.java:644-650）"
set poly null
set flare null
set cfg.next 0
set sx @thisx
set sy @thisy
set lx @thisx
set ly @thisy
set cfg.item null
set tmp.lnk null
ubind @poly
jump 30 strictEqual @unit null
sensor tmp.ty @unit @type
sensor tmp.nm tmp.ty @name
write @unit @this tmp.nm
sensor tmp.f @unit @firstItem
jump 24 notEqual tmp.f null
ucontrol approach sx sy 6.5 0 0
ucontrol itemTake st cfg.item 999 0 0
jump 30 always
jump 28 notEqual tmp.f cfg.item
ucontrol approach lx ly 6.5 0 0
ucontrol itemDrop tmp.lnk 999 0 0
jump 30 always
ucontrol approach sx sy 6.5 0 0
ucontrol itemDrop st 999 0 0
ubind @flare
jump 46 strictEqual @unit null
sensor tmp.ty @unit @type
sensor tmp.nm tmp.ty @name
write @unit @this tmp.nm
sensor tmp.f @unit @firstItem
jump 40 notEqual tmp.f null
ucontrol approach sx sy 6.5 0 0
ucontrol itemTake st cfg.item 999 0 0
jump 46 always
jump 44 notEqual tmp.f cfg.item
ucontrol approach lx ly 6.5 0 0
ucontrol itemDrop tmp.lnk 999 0 0
jump 46 always
ucontrol approach sx sy 6.5 0 0
ucontrol itemDrop st 999 0 0
jump 14 lessThan @time cfg.next
op add cfg.next @time 2000
getlink tmp.lnk 1
sensor lx tmp.lnk @x
sensor ly tmp.lnk @y
sensor tmp.ic sorter1 @config
jump 54 strictEqual tmp.ic null
set cfg.item tmp.ic
ulocate building core 0 0 sx sy tmp.g st
jump 14 always 0 "aigenerated:DeepSeek:a70a83b2bcf8"
