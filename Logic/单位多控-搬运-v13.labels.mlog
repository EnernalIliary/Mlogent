# mlogc 生成：mode=haul slots=35 type=@poly refill=2000ms cap=12 source=core
# 热循环 423 条 -> micro 每单位刷新 211.50 tick / 3.525 s
# 全程序 981 条（含补员突发）；micro(2 ipt) 最坏整圈 490 tick / 8.18 s
init:
set N 8
boot:
ubind @poly
sensor cfg.utype @unit @type
jump boot strictEqual cfg.utype null
set cfg.cap 12
set cfg.next 0
set sx @thisx
set sy @thisy
set lx @thisx
set ly @thisy
set cfg.tgt 1
op min N N 35
op max N N 1
set tmp.base @counter
op add tmp.off tmp.base 423
hot:
op mul tmp.p N -12
op add @counter tmp.off tmp.p
u35:
ubind u35
sensor tmp.f @unit @firstItem
jump u35d notEqual tmp.f null
ucontrol move sx sy 3 0 0
ucontrol itemTake st cfg.item 999 0 0
jump u35e always
u35d:
jump u35j notEqual tmp.f cfg.item
ucontrol move lx ly 3 0 0
ucontrol itemDrop tmp.lnk 999 0 0 0
jump u35e always
u35j:
ucontrol move cbx cby 3 0 0
ucontrol itemDrop cbc 999 0 0 0
u35e:
