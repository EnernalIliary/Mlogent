jump u3e always
u3j:
ucontrol approach cbx cby 6.5 0 0
ucontrol itemDrop cbc 999 0 0 0
u3e:
u2:
ubind u2
sensor tmp.f @unit @firstItem
jump u2d notEqual tmp.f null
ucontrol approach sx sy 6.5 0 0
ulocate building storage 0 0 vx vy tmp.g2 vault
jump u2k equal vault tmp.lnk
ucontrol itemTake vault cfg.item 999 0 0
u2k:
ucontrol itemTake st cfg.item 999 0 0
sensor tmp.f @unit @firstItem
jump u2e strictEqual tmp.f null
u2d:
jump u2j notEqual tmp.f cfg.item
ucontrol approach lx ly 6.5 0 0
ucontrol itemDrop tmp.lnk 999 0 0 0
sensor tmp.f @unit @firstItem
jump u2e notEqual tmp.f null
ucontrol approach sx sy 6.5 0 0
jump u2e always
u2j:
ucontrol approach cbx cby 6.5 0 0
ucontrol itemDrop cbc 999 0 0 0
u2e:
u1:
ubind u1
sensor tmp.f @unit @firstItem
jump u1d notEqual tmp.f null
ucontrol approach sx sy 6.5 0 0
ulocate building storage 0 0 vx vy tmp.g2 vault
jump u1k equal vault tmp.lnk
ucontrol itemTake vault cfg.item 999 0 0
u1k:
ucontrol itemTake st cfg.item 999 0 0
sensor tmp.f @unit @firstItem
jump u1e strictEqual tmp.f null
u1d:
jump u1j notEqual tmp.f cfg.item
ucontrol approach lx ly 6.5 0 0
ucontrol itemDrop tmp.lnk 999 0 0 0
sensor tmp.f @unit @firstItem
jump u1e notEqual tmp.f null
ucontrol approach sx sy 6.5 0 0
jump u1e always
u1j:
ucontrol approach cbx cby 6.5 0 0
ucontrol itemDrop cbc 999 0 0 0
u1e:
gate:
jump refill greaterThanEq @time cfg.next
hot:
jump gate strictEqual cfg.item null
op add @counter @counter tmp.hp
refill:
op add cfg.next @time 2000
set tmp.t 0
getlink tmp.lnk 0
jump rf1 strictEqual tmp.lnk null
sensor lx tmp.lnk @x
sensor ly tmp.lnk @y
rf1:
ubind cfg.utype
sensor uty @unit @type
jump hot strictEqual uty null
set tmp.cbk @counter
op mul tmp.p N -2
op add tmp.cbo tmp.cbk 19
op add @counter tmp.cbo tmp.p
chk8:
sensor tmp.c u8 @controller
jump fill8 strictEqual tmp.c null
chk7:
sensor tmp.c u7 @controller
jump fill7 strictEqual tmp.c null
chk6:
sensor tmp.c u6 @controller
jump fill6 strictEqual tmp.c null
chk5:
sensor tmp.c u5 @controller
jump fill5 strictEqual tmp.c null
chk4:
sensor tmp.c u4 @controller
jump fill4 strictEqual tmp.c null
chk3:
sensor tmp.c u3 @controller
jump fill3 strictEqual tmp.c null
chk2:
sensor tmp.c u2 @controller
jump fill2 strictEqual tmp.c null
chk1:
sensor tmp.c u1 @controller
jump fill1 strictEqual tmp.c null
jump hot always
fill8:
f8:
op add tmp.t tmp.t 1
jump hot greaterThan tmp.t cfg.cap
ubind uty
sensor tmp.c @unit @controller
jump hot strictEqual @unit null
jump f8 notEqual tmp.c @unit
set u8 @unit
ucontrol payDrop
jump chk7 always
fill7:
f7:
op add tmp.t tmp.t 1
jump hot greaterThan tmp.t cfg.cap
ubind uty
sensor tmp.c @unit @controller
jump hot strictEqual @unit null
jump f7 notEqual tmp.c @unit
set u7 @unit
ucontrol payDrop
jump chk6 always
fill6:
f6:
op add tmp.t tmp.t 1
jump hot greaterThan tmp.t cfg.cap
ubind uty
sensor tmp.c @unit @controller
jump hot strictEqual @unit null
jump f6 notEqual tmp.c @unit
set u6 @unit
ucontrol payDrop
jump chk5 always
fill5:
f5:
op add tmp.t tmp.t 1
jump hot greaterThan tmp.t cfg.cap
ubind uty
sensor tmp.c @unit @controller
jump hot strictEqual @unit null
jump f5 notEqual tmp.c @unit
set u5 @unit
ucontrol payDrop
jump chk4 always
fill4:
f4:
op add tmp.t tmp.t 1
jump hot greaterThan tmp.t cfg.cap
ubind uty
sensor tmp.c @unit @controller
jump hot strictEqual @unit null
jump f4 notEqual tmp.c @unit
set u4 @unit
ucontrol payDrop
jump chk3 always
fill3:
f3:
op add tmp.t tmp.t 1
jump hot greaterThan tmp.t cfg.cap
ubind uty
sensor tmp.c @unit @controller
jump hot strictEqual @unit null
jump f3 notEqual tmp.c @unit
set u3 @unit
ucontrol payDrop
jump chk2 always
fill2:
f2:
op add tmp.t tmp.t 1
jump hot greaterThan tmp.t cfg.cap
ubind uty
sensor tmp.c @unit @controller
jump hot strictEqual @unit null
jump f2 notEqual tmp.c @unit
set u2 @unit
ucontrol payDrop
jump chk1 always
fill1:
f1:
op add tmp.t tmp.t 1
jump hot greaterThan tmp.t cfg.cap
ubind uty
sensor tmp.c @unit @controller
jump hot strictEqual @unit null
jump f1 notEqual tmp.c @unit
set u1 @unit
ucontrol payDrop
jump hot always
jump hot always
sensor tmp.ic tmp.lnk @config
jump ic1 notEqual tmp.ic null
sensor tmp.ic cbc @firstItem
ic1:
jump ic2 strictEqual tmp.ic null
set cfg.item tmp.ic
ic2:
jump hot always
