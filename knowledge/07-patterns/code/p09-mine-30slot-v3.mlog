print "[#ffd166]多控挖矿[] v3 · 30 槽单位多控"
print "By - [blue]DeepSeek[]"
print "半编译产物：硬编码 30 槽，set N 1~30，小逻辑满速"
print "N=8 一圈 3+8*18 = 147 条 = 1.23 s（micro 2 ipt）"
print "补员认领时发一次 boost：pulsar 1.6x / quasar 2.0x 移动提速"
print "矿格是 Floor（solid=false），引擎不会自动助推，须显式开"
print "ulocate ore 只在时间闸门（3 s）重定位，全队共享矿区坐标"
print "挖满才回投递点；卸空立刻回矿区；货不对 drop @air 清仓"
print "矿种读 sorter1 的 @config（每 2 s 重读），投递 getlink 1"
print "改兵种只改 ubind 一行；不能 boost 的兵种（poly）自动无效"

set N 8
ubind @pulsar
sensor cfg.utype @unit @type
jump 11 strictEqual cfg.utype null
op mul cfg.cap N 2
op add cfg.cap cfg.cap 4
set cfg.next 0
set cfg.nloc 0
set sx @thisx
set sy @thisy
set lx @thisx
set ly @thisy
sensor tmp.ic sorter1 @config
jump 25 strictEqual tmp.ic null
set cfg.item tmp.ic
set ox null
set oy null
set cfg.ore null
op min N N 30
op max N N 1
op mul tmp.hp N -18
op sub tmp.hp tmp.hp 3
jump 574 always
ubind u30
sensor tmp.f @unit @firstItem
jump 47 strictEqual tmp.f null
jump 46 notEqual tmp.f cfg.item
sensor tmp.n @unit @totalItems
sensor tmp.c @unit @itemCapacity
jump 47 lessThan tmp.n tmp.c
jump 47 strictEqual tmp.lnk null
ucontrol approach lx ly 6.5 0 0
ucontrol itemDrop tmp.lnk 999 0 0 0
sensor tmp.f @unit @firstItem
jump 47 strictEqual tmp.f null
jump 51 always
ucontrol itemDrop @air 999 0 0 0
jump 51 strictEqual ox null
ucontrol approach ox oy 6.5 0 0
ucontrol mine ox oy 0 0 0
jump 51 always
