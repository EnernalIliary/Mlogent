ubind u7
ucontrol move @thisx @thisy 0 0 0
ubind u8
ucontrol move @thisx @thisy 0 0 0
jump 3 lessThan @time cfg.next

op add cfg.next @time 2000
set tmp.t 0
ubind @mono
sensor uty @unit @type
jump 3 strictEqual uty null

sensor tmp.c u1 @controller
jump 30 equal tmp.c @this
jump 67 strictEqual tmp.c null
ubind u1
ucontrol move @thisx @thisy 0 0 0
sensor tmp.c u2 @controller
jump 35 equal tmp.c @this
jump 77 strictEqual tmp.c null
