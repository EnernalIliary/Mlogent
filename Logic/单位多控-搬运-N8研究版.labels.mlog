op add tmp.t tmp.t 1
jump loc greaterThan tmp.t cfg.cap
ubind uty
sensor tmp.c @unit @controller
jump loc strictEqual @unit null
jump f6 notEqual tmp.c @unit
set u6 @unit
ucontrol payDrop
jump chk5 always
fill5:
f5:
op add tmp.t tmp.t 1
jump loc greaterThan tmp.t cfg.cap
ubind uty
sensor tmp.c @unit @controller
jump loc strictEqual @unit null
jump f5 notEqual tmp.c @unit
set u5 @unit
ucontrol payDrop
jump chk4 always
fill4:
f4:
op add tmp.t tmp.t 1
jump loc greaterThan tmp.t cfg.cap
ubind uty
sensor tmp.c @unit @controller
jump loc strictEqual @unit null
jump f4 notEqual tmp.c @unit
set u4 @unit
ucontrol payDrop
jump chk3 always
fill3:
f3:
op add tmp.t tmp.t 1
jump loc greaterThan tmp.t cfg.cap
ubind uty
sensor tmp.c @unit @controller
jump loc strictEqual @unit null
jump f3 notEqual tmp.c @unit
set u3 @unit
ucontrol payDrop
jump chk2 always
fill2:
f2:
op add tmp.t tmp.t 1
jump loc greaterThan tmp.t cfg.cap
ubind uty
sensor tmp.c @unit @controller
jump loc strictEqual @unit null
jump f2 notEqual tmp.c @unit
set u2 @unit
ucontrol payDrop
jump chk1 always
fill1:
f1:
op add tmp.t tmp.t 1
jump loc greaterThan tmp.t cfg.cap
ubind uty
sensor tmp.c @unit @controller
jump loc strictEqual @unit null
jump f1 notEqual tmp.c @unit
set u1 @unit
ucontrol payDrop
jump loc always
jump loc always
loc:
ubind u1
jump loc0 notEqual @unit null
jump hot always
loc0:
jump locgo strictEqual cbc null
jump locF strictEqual st null
jump locr strictEqual tmp.needloc 0
locF:
jump locr lessThan @time cfg.nloc
locgo:
ulocate building core 0 cfg.item sx sy tmp.g st
ulocate building core 0 0 cbx cby tmp.g3 cbc
op add cfg.nloc @time 3000
set tmp.needloc 0
jump rf2 notEqual st tmp.lnk
set st null
rf2:
jump rf3 notEqual tmp.lnk null
set st null
rf3:
locr:
sensor tmp.ic sorter1 @config
jump ic1 notEqual tmp.ic null
sensor tmp.ic cbc @firstItem
ic1:
jump ic2 strictEqual tmp.ic null
set cfg.item tmp.ic
ic2:
jump hot always
