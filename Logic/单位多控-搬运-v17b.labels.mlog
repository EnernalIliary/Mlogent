# mlogc 生成：mode=haul slots=26 type=@flare refill=2000ms cap=0 source=core live
# 热循环 445 条 -> micro 满载每圈 222.50 tick / 3.708 s
# 全程序 973 条（含补员突发）；micro(2 ipt) 最坏整圈 486 tick / 8.11 s
init:
set N 8
set L 1
boot:
ubind @flare
sensor cfg.utype @unit @type
jump boot strictEqual cfg.utype null
op mul cfg.cap N 2
op add cfg.cap cfg.cap 4
set cfg.next 0
set cfg.nloc 0
set sx @thisx
set sy @thisy
set lx @thisx
set ly @thisy
set cfg.tgt 1
op min N N 26
op max N N 1
set L N
set tmp.base @counter
op add tmp.off tmp.base 445
hot:
op mul tmp.p L -17
op add @counter tmp.off tmp.p
u26:
ubind u26
sensor tmp.f @unit @firstItem
jump u26d notEqual tmp.f null
ucontrol move sx sy 3 0 0
ulocate building storage 0 0 vx vy tmp.g2 vault
jump u26k equal vault tmp.lnk
ucontrol itemTake vault cfg.item 999 0 0
u26k:
ucontrol itemTake st cfg.item 999 0 0
ucontrol move lx ly 3 0 0
jump u26e always
u26d:
jump u26j notEqual tmp.f cfg.item
ucontrol move lx ly 3 0 0
ucontrol itemDrop tmp.lnk 999 0 0 0
ucontrol move sx sy 3 0 0
jump u26e always
u26j:
ucontrol move cbx cby 3 0 0
ucontrol itemDrop cbc 999 0 0 0
u26e:
