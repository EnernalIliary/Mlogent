ubind u1
sensor tmp.f @unit @firstItem
jump u1d notEqual tmp.f null
ucontrol approach sx sy 6.5 0 0
ulocate building storage 0 0 vx vy tmp.g2 vault
jump u1k equal vault tmp.lnk
ucontrol itemTake vault cfg.item 999 0 0
u1k:
