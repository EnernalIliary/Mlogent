set elude null
set avert null
set cfg.next 0
set cfg.item null
set tmp.lnk null
set sx @thisx
set sy @thisy
set lx @thisx
set ly @thisy
set tmp.i 0
lookup unit tmp.ty tmp.i
sensor tmp.nm tmp.ty @name
read u @this tmp.nm
jump 81 strictEqual u null
ubind u
jump 81 strictEqual @unit null
sensor tmp.f @unit @firstItem
jump 75 notEqual tmp.f null
ucontrol approach sx sy 6.5 0 0
ucontrol itemTake st cfg.item 999 0 0
jump 81 always
jump 79 notEqual tmp.f cfg.item
ucontrol approach lx ly 6.5 0 0
ucontrol itemDrop tmp.lnk 999 0 0
jump 81 always
ucontrol approach sx sy 6.5 0 0
ucontrol itemDrop st 999 0 0
op add tmp.i tmp.i 1
jump 64 lessThan tmp.i 50
jump 63 lessThan @time cfg.next
op add cfg.next @time 2000
getlink tmp.lnk 1
sensor lx tmp.lnk @x
sensor ly tmp.lnk @y
sensor tmp.ic sorter1 @config
jump 91 strictEqual tmp.ic null
set cfg.item tmp.ic
ubind @poly
jump 94 strictEqual @unit null
ulocate building core 0 0 sx sy tmp.g st
set tmp.i 0
set tmp.t 0
lookup unit tmp.ty tmp.i
sensor tmp.nm tmp.ty @name
read u @this tmp.nm
jump 108 notEqual u null
ubind @poly
jump 108 strictEqual @unit null
sensor tmp.c @unit @controller
jump 108 notEqual tmp.c @unit
write @unit @this tmp.nm
ucontrol payDrop
op add tmp.t tmp.t 1
jump 110 greaterThanEq tmp.t 6
op add tmp.i tmp.i 1
jump 96 lessThan tmp.i 50
jump 63 always 0 "aigenerated:DeepSeek:95f239833e08"
