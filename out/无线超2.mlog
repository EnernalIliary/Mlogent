ubind @flare
sensor d @unit @dead
jump 0 equal d 1
jump 5 strictEqual @unit null
sensor c @unit @controller
jump 0 notEqual c @this
jump 0 notEqual c @unit
sensor fi @unit @firstItem
sensor ph dome1 @phase-fabric
sensor si dome1 @silicon
select cfg lessThanEq ph si @phase-fabric @silicon
ulocate building core 0 @copper cx cy 0 core
jump 0 strictEqual cx null
jump 18 equal fi null
jump 18 equal fi cfg
ucontrol itemDrop core 999 0 0 0
jump 0 strictEqual fi cfg
ucontrol move cx cy 0 0 0
sensor need dome1 cfg
op sub need 10 need
op mul need need 1.25
jump 0 lessThan need 1
ulocate building storage 0 @copper 0 0 f ss
ucontrol itemTake ss cfg need 0 0
ucontrol itemTake core cfg need 0 0
end
sensor bx dome1 @x
sensor by dome1 @y
jump 0 strictEqual by null
ucontrol move bx by 0 0 0
ucontrol itemDrop dome1 999 0 0 0
jump 0 always 0 false
