sensor tmp.c u8 @controller
jump 137 strictEqual tmp.c null
jump 64 notEqual tmp.c @this
jump 3 always 0 0
ubind u8
ucontrol move @thisx @thisy 0 0 0
jump 3 always 0 0

jump 30 greaterThan 1 N
op add tmp.t tmp.t 1
jump 30 greaterThan tmp.t cfg.cap
ubind uty
sensor tmp.c @unit @controller
jump 30 strictEqual @unit null
jump 68 notEqual tmp.c @unit
set u1 @unit
ucontrol move @thisx @thisy 0 0 0
jump 30 always 0 0

jump 35 greaterThan 2 N
op add tmp.t tmp.t 1
jump 35 greaterThan tmp.t cfg.cap
ubind uty
sensor tmp.c @unit @controller
jump 35 strictEqual @unit null
jump 78 notEqual tmp.c @unit
set u2 @unit
ucontrol move @thisx @thisy 0 0 0
jump 35 always 0 0

jump 40 greaterThan 3 N
