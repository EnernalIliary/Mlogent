jump tail0 always
fill29:
f29:
op add tmp.t tmp.t 1
jump tail0 greaterThan tmp.t cfg.cap
ubind uty
sensor tmp.c @unit @controller
jump tail0 strictEqual @unit null
jump f29 notEqual tmp.c @unit
set u29 @unit
set s29 0
