# 上游源码树：各自带独立的 .git，本仓库不跟踪（需要时用 submodule）
/Mindustry-Source/
/Arc-Source/

# 已拆出去的独立项目：它们是本仓库的同级目录（D:\Develop\...），不再进本仓库。
# 名字里的 assetsraw 在盘上叫 Mindustry_assetsraw，清单里仍按旧名挡住。
/assetsraw/
/MBO/
/ratio-calc/
/pixil/

# server runtime data if a headless server is started from the repo root
/config/

# 生成物与垃圾
/out/npmcache/
__pycache__/
*.pyc

# out/ 是工作区：里面 143 个产物是跟踪的，其余是一次性探针脚本/仿真缓存/备份。
# 整目录忽略，免得几千个散文件把 `git status` 淹掉；要提交某个新产物用 `git add -f`。
/out/

# 系统文件
desktop.ini
Thumbs.db
.DS_Store

# derived scan artifacts (rebuildable, large)
out/caime/
out/caime_scan.json
out/_sweep_*.txt
out/mine_scan.json
out/_portrait*.txt
out/_user*.msch
out/_junk.msch
out/caime_scan*.txt
.find_cache.json
/out/_label_backup_*/
/out/_label_*.txt
/out/_find*.txt
/out/_sweep_*.txt
/out/_ili_backup_*/

# publishable export (own git repo) - /dist/mlog-toolkit
/dist/

# 打包产物（tools/package.py 重建即可：树 + zip，几百 KB，含逐文件副本）
/out/_dist/
/out/_packtest/
/out/_exe/

# 外部蓝图语料（tools/dev/fetch_schematics.py 重抓即可，不要入库）
/logic-corpus/

# 本地知识库：模型/依赖/索引都只在本机，不进仓库
/out/_kblibs/
/out/_kbmodels/
/out/_kb/

# 知识库的 Python 3.11 依赖副本（3.12 用 out/_kblibs）
/out/_kblibs311/

# temporary probe scripts (archived, not tracked)
/out/_archive/
out/_publish/
