# core-bench: read core stock, take 15, drop 5, read again.
# Run with --core-items silicon:400 --units mono:1 on the blank world.
# Uses a non-blocking timer instead of wait (see 逻辑代码规范.md).
ubind @mono
ulocate building core false @copper core.x core.y core.found? core
jump 16 equal core.found? 0
sensor si core @silicon
jump 8 greaterThan have 0
ucontrol itemTake core @silicon 15 0 0
sensor have @unit @totalItems
jump 0 equal have 0
jump 11 notEqual armed 0
op add t @time 300
set armed 1
jump 0 lessThan @time t
ucontrol itemDrop core 5 0 0
sensor left @unit @totalItems
jump 0 greaterThan left 10
sensor after core @silicon
stop
