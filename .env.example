# mlog-agentskill — 环境变量示例
#
# 注意：这些是**进程环境变量**，工具不读 .env 文件；复制成 .env 不会自动生效。
# 用法（挑一种）：
#   PowerShell :  $env:MLOGSIM_JAVA = "F:/.../java.exe"
#   bash       :  export MLOGSIM_JAVA="F:/.../java.exe"
#   持久化     :  setx MLOGSIM_JAVA "F:\...\java.exe"   (新开终端生效)
#
# 所有变量都有默认值，一个都不设也能跑。留空的项等于「用默认」。

# ---------------------------------------------------------------- 真执行器模拟器
# tools/mlogsim.py（技能副本里没有这个工具）。默认 <repo>/out/_server160.jar；
# 换执行器版本：out/_server159.jar、out/_server146.jar（数据表里 source: 标的版本
# 是数据表来源，不是模拟器版本）。
MLOGSIM_JAR=
# 默认 <repo>/out/jre21/jdk-21.0.5+11-jre/bin/java.exe。
# 系统 PATH 上的 java 若是 Java 8 桩，必须设这个，否则模拟器起不来。
MLOGSIM_JAVA=
# 模拟工作目录（场景、trace、临时存档），默认 <repo>/out/_sim。
MLOG_SIM_BASEDIR=

# ---------------------------------------------------------------- 语料与蓝图输出
# style / find 用的蓝图语料；默认 %USERPROFILE%/AppData/Roaming/Mindustry/schematics。
MLOG_CORPUS=
# rules/ 规则库目录；默认沿模块向上找最近的 rules/（含 *.json 的那个）。
MLOG_RULES_DIR=
# mschgen / gen 写蓝图的目录；默认 %APPDATA%/Mindustry/schematics。
MINDUSTRY_SCHEMATICS=
# verify_msch.py 的对照目录；默认同上。
MLOG_SCHEM=

# ---------------------------------------------------------------- 签名
# aigenerated.py 签名行里的作者名，默认 MAI（必须是 ASCII：非中文区控制台会
# UnicodeEncodeError）。签名行形如 jump 0 always 0 "aigenerated:MAI:<12hex>"。
MAI_SIGN_AUTHOR=

# ---------------------------------------------------------------- 本地知识库 tools/kb.py
# 需要 pip install -r requirements.txt（fastembed）。不设则用仓库内默认路径。
KB_ROOT=
KB_DIR=
KB_LIBS=
KB_MODELS=
KB_EMB_MODEL=BAAI/bge-small-zh-v1.5
KB_RERANK_MODEL=BAAI/bge-reranker-base
KB_KNOWLEDGE=
# 检索策略三开关（默认全开；置 0 关闭，用于对照实验，见 tools/kb.py:92-107）
KB_ONLY_KNOWLEDGE=1
KB_DEDUPE_FILE=1
KB_ASCII_BOOST=1
KB_CANDIDATES=40
# 非空即打印检索调试明细
KB_DEBUG=

# ---------------------------------------------------------------- 技能副本同步
# sync_mlogagent.py --global 的目标根目录；默认 ~/.dsh
DSH_HOME=