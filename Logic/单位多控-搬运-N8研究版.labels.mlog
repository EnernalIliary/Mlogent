# mlogc 生成：mode=haul slots=8 type=@flare refill=2000ms cap=0 source=core
# 热循环 164 条 -> micro 满载每圈 82.00 tick / 1.367 s
# 全程序 305 条（含补员突发）；micro(2 ipt) 最坏整圈 152 tick / 2.54 s
print "DS快速响应多供一 · 研究版（8 槽）"
print "By - [blue]Ili[#8abcd1]ary[#654321]艾铭[#ffb6c1]✽[] & DeepSeek"
print "半编译产物：硬编码 8 槽，set N 1~8，micro 满速"
print "N=8 满槽一圈 164 条 = 1.37 s 上界；单位交互冷却 1.5 s"
print "槽结构 20 条：ubind→判空手→顺路取货→取货→判到手→[杂物腿]→投递→判卸空→掉头"
print "短路径：取到货即拐投递点、卸空即掉头；核心定位 3 s 节流，体检 2 s 降频"
print "改兵种只改 ubind 一行；投递 getlink 1，物品读 sorter1 的 @config"
printflush message1
init:
set N 8
boot:
ubind @flare
sensor cfg.utype @unit @type
jump boot strictEqual cfg.utype null
op mul cfg.cap N 2
op add cfg.cap cfg.cap 4
set cfg.next 0
set cfg.nloc 0
set tmp.needloc 1
set sx @thisx
set sy @thisy
set lx @thisx
set ly @thisy
op min N N 8
op max N N 1
set tmp.base @counter
op add tmp.off tmp.base 164
hot:
jump gate strictEqual cfg.item null
op mul tmp.p N -20
op add @counter tmp.off tmp.p
u8:
ubind u8
sensor tmp.f @unit @firstItem
jump u8d notEqual tmp.f null
ucontrol approach sx sy 6.5 0 0
ulocate building storage 0 0 vx vy tmp.g2 vault
jump u8k equal vault tmp.lnk
ucontrol itemTake vault cfg.item 999 0 0
u8k:
ucontrol itemTake st cfg.item 999 0 0
sensor tmp.f @unit @firstItem
jump u8e strictEqual tmp.f null
u8d:
jump u8j notEqual tmp.f cfg.item
ucontrol approach lx ly 6.5 0 0
ucontrol itemDrop tmp.lnk 999 0 0 0
sensor tmp.f @unit @firstItem
jump u8e notEqual tmp.f null
set tmp.needloc 1
ucontrol approach sx sy 6.5 0 0
jump u8e always
u8j:
ucontrol approach cbx cby 6.5 0 0
ucontrol itemDrop cbc 999 0 0 0
u8e:
u7:
ubind u7
sensor tmp.f @unit @firstItem
jump u7d notEqual tmp.f null
ucontrol approach sx sy 6.5 0 0
ulocate building storage 0 0 vx vy tmp.g2 vault
jump u7k equal vault tmp.lnk
ucontrol itemTake vault cfg.item 999 0 0
