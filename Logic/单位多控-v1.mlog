jump 40 greaterThan tmp.t cfg.cap
ubind uty
sensor tmp.c @unit @controller
jump 40 strictEqual @unit null
jump 88 notEqual tmp.c @unit
set u3 @unit
ucontrol move @thisx @thisy 0 0 0
jump 40 always 0 0

