out/caime/
out/caime_scan.json
out/_sweep_*.txt
out/mine_scan.json
out/_portrait*.txt
out/_user*.msch
out/_junk.msch
out/caime_scan*.txt
.find_cache.json
/out/_label_backup_*/
/out/_label_*.txt
/out/_find*.txt
/out/_sweep_*.txt
/out/_ili_backup_*/

# publishable export (own git repo) - /dist/mlog-toolkit
/dist/

# 打包产物（tools/package.py 重建即可：树 + zip，几百 KB，含逐文件副本）
/out/_dist/
/out/_packtest/
/out/_exe/

# 外部蓝图语料（tools/dev/fetch_schematics.py 重抓即可，不要入库）
/logic-corpus/

# 本地知识库：模型/依赖/索引都只在本机，不进仓库
/out/_kblibs/
/out/_kbmodels/
/out/_kb/

# 知识库的 Python 3.11 依赖副本（3.12 用 out/_kblibs）
/out/_kblibs311/

# temporary probe scripts (archived, not tracked)
/out/_archive/
out/_publish/
