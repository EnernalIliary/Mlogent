print "[#ffd166] 落子 LUOZI[] v6 · 硬编码版（上限 8 台）\n"
print "-调和+占空着陆控制逻辑 · 半编译产物\n\n"
print "微处理器专用：一圈 408 条 = 3.40 s（2 ipt）\n"
print "打分 = 权重 × 库存缺口（线性），三趟全展开\n"
print "分配 = 累计切片（最大余数），末位台兜底不空转\n"
print "上限 8 台 = 链接顺序上的前 8 个接收台\n"
print "核心靠 ulocate 取，需至少 1 只可用单位\n\n"
print "By - [blue]DeepSeek[] x [blue]Ili[#8abcd1]ary[#654321]艾铭[#ffb6c1]✽"
printflush message1
set w.copper 0.5
set w.lead 0.5
set w.metaglass 1
set w.graphite 1
set w.titanium 5
set w.thorium 2
set w.silicon 5
set w.plastanium 0.8
set w.phase_fabric 0.1
set w.surge_alloy 1
set w.blast_compound 0.01
set w.pyratite 0.01
init:
set next 0
set core null
set last -1
set uiok 0
set time.rec @time
main:
jump work greaterThanEq @time next
jump main always
work:
op add next @time 10000
sensor tmp.tot core @totalItems
jump run notEqual tmp.tot last
jump main always
run:
set npad 0
set p 0
c0:
jump c1 greaterThanEq p @links
jump c1 greaterThanEq npad 8
getlink b p
jump c2 strictEqual b null
sensor ty b @type
jump c2 notEqual ty @landing-pad
op add npad npad 1
c2:
op add p p 1
jump c0 always
c1:
l0:
sensor cap core @itemCapacity
jump p1x notEqual cap null
set core null
set ui uiok
fc:
lookup unit uty ui
ubind uty
jump fok notEqual @unit null
op add ui ui 1
jump fc lessThan ui 52
jump l1b always
fok:
set uiok ui
ulocate building core false 0 cx cy f core
ucontrol unbind 0 0 0 0 0
jump p1x notEqual core null
l1b:
print "[#ffd166] 落子 LUOZI[]\n-调和+占空着陆控制逻辑  \n\n[red]启动受阻[gray]\n[yellow]检查你是否有任意可用单位。[]\n若有、链接任意数量接收台。而后即可开始。\n\nBy - [blue]DeepSeek[] x [blue]Ili[#8abcd1]ary[#654321]艾铭[#ffb6c1]✽"
printflush message1
set p 0
l1c:
jump p1x greaterThanEq p @links
getlink b p
op add p p 1
jump l1c strictEqual b null
sensor cap b @itemCapacity
jump l1c strictEqual cap null
jump l1c lessThan cap 4000
set core b
p1x:
jump r1 strictEqual core null
set mx 0
set sw 0
sensor amt core @copper
op max mx mx amt
op mul t amt w.copper
op add sw sw t
sensor amt core @lead
op max mx mx amt
op mul t amt w.lead
op add sw sw t
sensor amt core @metaglass
op max mx mx amt
op mul t amt w.metaglass
op add sw sw t
sensor amt core @graphite
op max mx mx amt
op mul t amt w.graphite
op add sw sw t
sensor amt core @sand
op max mx mx amt
sensor amt core @coal
op max mx mx amt
sensor amt core @titanium
op max mx mx amt
op mul t amt w.titanium
op add sw sw t
sensor amt core @thorium
op max mx mx amt
op mul t amt w.thorium
op add sw sw t
sensor amt core @scrap
op max mx mx amt
sensor amt core @silicon
