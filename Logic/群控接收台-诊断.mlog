print "=== 群控接收台诊断 ===\n"
print "links="
print @links
print "\n"
set p 0
jump 24 greaterThanEq p @links
getlink b p
sensor ty b @type
sensor eff b @efficiency
sensor tot b @totalItems
sensor cap b @itemCapacity
print "L"
print p
print " "
print ty
print " eff="
print eff
print " items="
print tot
print " cap="
print cap
print "\n"
op add p p 1
jump 5 always
print "--- 单位 ---\n"
set u 0
set ut null
lookup unit ut u
ubind ut
jump 32 notEqual @unit null
op add u u 1
jump 27 lessThan u 52
print "unit="
print @unit
print "\n"
jump 38 strictEqual @unit null
ulocate building core false 0 cx cy fnd core
ucontrol unbind 0 0 0 0 0
print "core="
print core
print " x="
print cx
print " y="
print cy
print "\n"
print "判定：eff!=1 的台没水；npad=0 就不会配置任何台\n"
printflush message1
wait 600
jump 0 always 0 "aigenerated:DeepSeek:4ee1f2164a7e:altbMSwwLCIjIOe-pOaOp-aOpeaUtuWPsCDor4rmlq3vvIjotLTov5vlpITnkIblmajvvIzphY3kuIDkuKogbWVzc2FnZTEg5raI5oGv5Z2X55yL6L6T5Ye677yJIl0sWzIsMCwiIyDmiZPljbDvvJrpk77mjqXooajvvIjnsbvlnosv5rC06YeP6Ze46ZeoL-W6k-WtmC_lrrnph4_vvInjgIHog73lkKbnu5HlrprliLDljZXkvY3jgIHog73lkKYgdWxvY2F0ZSDliLDmoLjlv4MiXV0"
