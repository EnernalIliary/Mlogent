 {
  "rule": "printflush-clears-buffer",
  "sev": "INFO",
  "file": "mindustrytop-25774.msav",
  "x": 125,
  "y": 137,
  "block": "logic-processor",
  "line": 24,
  "code": "printflush Notification",
  "msg": "`Notification` is never assigned, so this `printflush` has no valid message block -- and that is NOT a no-op: PrintFlushI clears the print buffer unconditionally (LExecutor.java:1178), so everything queued by `print` is DISCARDED here. A deliberate way to empty the buffer; it also parks the name in the editor's variable list",
  "hash": "70ebdfce443f",
  "id": "269f513151"
 },
