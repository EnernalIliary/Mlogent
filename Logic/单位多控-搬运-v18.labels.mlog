# mlogc 生成：mode=haul slots=29 type=@poly refill=2000ms cap=0 source=core
# 热循环 554 条 -> micro 满载每圈 277.00 tick / 4.617 s
# 全程序 984 条（含补员突发）；micro(2 ipt) 最坏整圈 492 tick / 8.20 s
init:
set N 8
boot:
ubind @poly
sensor cfg.utype @unit @type
jump boot strictEqual cfg.utype null
op mul cfg.cap N 2
op add cfg.cap cfg.cap 4
set cfg.next 0
set cfg.nloc 0
set sx @thisx
set sy @thisy
set lx @thisx
set ly @thisy
set cfg.tgt 1
op min N N 29
op max N N 1
set tmp.base @counter
op add tmp.off tmp.base 554
hot:
op mul tmp.p N -19
op add @counter tmp.off tmp.p
u29:
ubind u29
jump u29e strictEqual st null
jump u29d greaterThan s29 0
ucontrol move sx sy 3 0 0
ulocate building storage 0 0 vx vy tmp.g2 vault
jump u29k equal vault tmp.lnk
ucontrol itemTake vault cfg.item 999 0 0
u29k:
ucontrol itemTake st cfg.item 999 0 0
sensor tmp.f @unit @firstItem
jump u29t equal tmp.f cfg.item
ucontrol itemDrop cbc 999 0 0 0
jump u29e always
u29t:
set s29 1
u29d:
ucontrol move lx ly 3 0 0
ucontrol itemDrop tmp.lnk 999 0 0 0
sensor tmp.f @unit @firstItem
jump u29e notEqual tmp.f null
set s29 0
ucontrol move sx sy 3 0 0
u29e:
