
set N 8
set cfg.cap 12
set cfg.next 0

ubind u1
ucontrol move @thisx @thisy 0 0 0
ubind u2
ucontrol move @thisx @thisy 0 0 0
ubind u3
ucontrol move @thisx @thisy 0 0 0
ubind u4
ucontrol move @thisx @thisy 0 0 0
ubind u5
