# mlogc 生成：mode=hold slots=8 type=@poly refill=2000ms cap=0 source=core
# 热循环 155 条 -> micro 满载每圈 77.50 tick / 1.292 s
# 全程序 281 条（含补员突发）；micro(2 ipt) 最坏整圈 140 tick / 2.34 s
init:
set N 8
boot:
ubind @poly
sensor cfg.utype @unit @type
jump boot strictEqual cfg.utype null
op mul cfg.cap N 2
op add cfg.cap cfg.cap 4
set cfg.next 0
set cfg.nloc 0
set sx @thisx
set sy @thisy
set lx @thisx
set ly @thisy
op min N N 8
op max N N 1
op mul tmp.hp N -19
op sub tmp.hp tmp.hp 3
jump hot always
u8:
ubind u8
sensor tmp.f @unit @firstItem
jump u8d notEqual tmp.f null
ucontrol approach sx sy 6.5 0 0
ulocate building storage 0 0 vx vy tmp.g2 vault
jump u8k equal vault tmp.lnk
ucontrol itemTake vault cfg.item 999 0 0
u8k:
ucontrol itemTake st cfg.item 999 0 0
sensor tmp.f @unit @firstItem
jump u8e strictEqual tmp.f null
u8d:
jump u8j notEqual tmp.f cfg.item
ucontrol approach lx ly 6.5 0 0
ucontrol itemDrop tmp.lnk 999 0 0 0
sensor tmp.f @unit @firstItem
jump u8e notEqual tmp.f null
ucontrol approach sx sy 6.5 0 0
jump u8e always
u8j:
ucontrol approach cbx cby 6.5 0 0
ucontrol itemDrop cbc 999 0 0 0
u8e:
u7:
ubind u7
sensor tmp.f @unit @firstItem
jump u7d notEqual tmp.f null
ucontrol approach sx sy 6.5 0 0
ulocate building storage 0 0 vx vy tmp.g2 vault
jump u7k equal vault tmp.lnk
ucontrol itemTake vault cfg.item 999 0 0
u7k:
ucontrol itemTake st cfg.item 999 0 0
sensor tmp.f @unit @firstItem
jump u7e strictEqual tmp.f null
u7d:
jump u7j notEqual tmp.f cfg.item
ucontrol approach lx ly 6.5 0 0
ucontrol itemDrop tmp.lnk 999 0 0 0
sensor tmp.f @unit @firstItem
jump u7e notEqual tmp.f null
ucontrol approach sx sy 6.5 0 0
jump u7e always
u7j:
ucontrol approach cbx cby 6.5 0 0
ucontrol itemDrop cbc 999 0 0 0
u7e:
u6:
ubind u6
sensor tmp.f @unit @firstItem
jump u6d notEqual tmp.f null
ucontrol approach sx sy 6.5 0 0
ulocate building storage 0 0 vx vy tmp.g2 vault
jump u6k equal vault tmp.lnk
ucontrol itemTake vault cfg.item 999 0 0
u6k:
ucontrol itemTake st cfg.item 999 0 0
sensor tmp.f @unit @firstItem
jump u6e strictEqual tmp.f null
u6d:
jump u6j notEqual tmp.f cfg.item
ucontrol approach lx ly 6.5 0 0
ucontrol itemDrop tmp.lnk 999 0 0 0
sensor tmp.f @unit @firstItem
jump u6e notEqual tmp.f null
ucontrol approach sx sy 6.5 0 0
jump u6e always
u6j:
ucontrol approach cbx cby 6.5 0 0
ucontrol itemDrop cbc 999 0 0 0
u6e:
u5:
ubind u5
sensor tmp.f @unit @firstItem
jump u5d notEqual tmp.f null
ucontrol approach sx sy 6.5 0 0
ulocate building storage 0 0 vx vy tmp.g2 vault
jump u5k equal vault tmp.lnk
ucontrol itemTake vault cfg.item 999 0 0
u5k:
ucontrol itemTake st cfg.item 999 0 0
sensor tmp.f @unit @firstItem
jump u5e strictEqual tmp.f null
u5d:
jump u5j notEqual tmp.f cfg.item
ucontrol approach lx ly 6.5 0 0
ucontrol itemDrop tmp.lnk 999 0 0 0
sensor tmp.f @unit @firstItem
jump u5e notEqual tmp.f null
ucontrol approach sx sy 6.5 0 0
jump u5e always
u5j:
ucontrol approach cbx cby 6.5 0 0
ucontrol itemDrop cbc 999 0 0 0
u5e:
u4:
ubind u4
sensor tmp.f @unit @firstItem
jump u4d notEqual tmp.f null
ucontrol approach sx sy 6.5 0 0
ulocate building storage 0 0 vx vy tmp.g2 vault
jump u4k equal vault tmp.lnk
ucontrol itemTake vault cfg.item 999 0 0
u4k:
ucontrol itemTake st cfg.item 999 0 0
sensor tmp.f @unit @firstItem
jump u4e strictEqual tmp.f null
u4d:
jump u4j notEqual tmp.f cfg.item
ucontrol approach lx ly 6.5 0 0
ucontrol itemDrop tmp.lnk 999 0 0 0
sensor tmp.f @unit @firstItem
jump u4e notEqual tmp.f null
ucontrol approach sx sy 6.5 0 0
jump u4e always
u4j:
ucontrol approach cbx cby 6.5 0 0
ucontrol itemDrop cbc 999 0 0 0
u4e:
u3:
ubind u3
sensor tmp.f @unit @firstItem
jump u3d notEqual tmp.f null
ucontrol approach sx sy 6.5 0 0
ulocate building storage 0 0 vx vy tmp.g2 vault
jump u3k equal vault tmp.lnk
ucontrol itemTake vault cfg.item 999 0 0
u3k:
ucontrol itemTake st cfg.item 999 0 0
sensor tmp.f @unit @firstItem
jump u3e strictEqual tmp.f null
u3d:
jump u3j notEqual tmp.f cfg.item
ucontrol approach lx ly 6.5 0 0
ucontrol itemDrop tmp.lnk 999 0 0 0
