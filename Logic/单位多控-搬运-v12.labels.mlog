# mlogc 生成：mode=haul slots=31 type=@poly refill=2000ms cap=12 source=core
# 热循环 499 条 -> micro 每单位刷新 249.50 tick / 4.158 s
# 全程序 997 条（含补员突发）；micro(2 ipt) 最坏整圈 498 tick / 8.31 s
init:
set N 8
boot:
ubind @poly
sensor cfg.utype @unit @type
jump boot strictEqual cfg.utype null
set cfg.cap 12
set cfg.next 0
set sx @thisx
set sy @thisy
set lx @thisx
set ly @thisy
set cfg.tgt 1
op min N N 31
op max N N 1
set tmp.base @counter
op add tmp.off tmp.base 499
hot:
op mul tmp.p N -16
op add @counter tmp.off tmp.p
u31:
ubind u31
jump u31e strictEqual st null
jump u31d greaterThan s31 0
ucontrol move sx sy 3 0 0
ucontrol itemTake st cfg.item 999 0 0
sensor tmp.f @unit @firstItem
jump u31t equal tmp.f cfg.item
ucontrol itemDrop cbc 999 0 0 0
jump u31e always
u31t:
set s31 1
u31d:
ucontrol move lx ly 3 0 0
ucontrol itemDrop tmp.lnk 999 0 0 0
sensor tmp.f @unit @firstItem
jump u31e notEqual tmp.f null
set s31 0
ucontrol move sx sy 3 0 0
u31e:
