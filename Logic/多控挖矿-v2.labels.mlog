# mlogc 生成：mode=mine slots=30 type=@poly refill=2000ms cap=0 source=core
# 热循环 543 条 -> micro 满载每圈 271.50 tick / 4.525 s
# 全程序 925 条（含补员突发）；micro(2 ipt) 最坏整圈 462 tick / 7.71 s
print "[#ffd166]多控挖矿[] v2 · 30 槽单位多控"
print "By - [blue]DeepSeek[]"
print "半编译产物：硬编码 30 槽，set N 1~30，小逻辑满速"
print "N=8 一圈 3+8*18 = 147 条 = 1.23 s（micro 2 ipt）"
print "ulocate ore 只在时间闸门（3 s）重定位，全队共享矿区坐标"
print "挖满才回投递点；卸空立刻回矿区；货不对 drop @air 清仓"
print "矿种读 sorter1 的 @config（每 2 s 重读），投递 getlink 1"
print "改兵种只改 ubind 一行（必须能挖：poly/mono）"
print "注意：矿点离最近核心 < 27.5 格时引擎会自动把满仓矿倒进核心"

init:
set N 8
boot:
ubind @poly
sensor cfg.utype @unit @type
jump boot strictEqual cfg.utype null
op mul cfg.cap N 2
op add cfg.cap cfg.cap 4
set cfg.next 0
set cfg.nloc 0
set sx @thisx
set sy @thisy
set lx @thisx
set ly @thisy
sensor tmp.ic sorter1 @config
jump ic2 strictEqual tmp.ic null
set cfg.item tmp.ic
ic2:
set ox null
set oy null
set cfg.ore null
op min N N 30
op max N N 1
op mul tmp.hp N -18
op sub tmp.hp tmp.hp 3
jump hot always
u30:
ubind u30
sensor tmp.f @unit @firstItem
jump u30m strictEqual tmp.f null
jump u30j notEqual tmp.f cfg.item
sensor tmp.n @unit @totalItems
sensor tmp.c @unit @itemCapacity
jump u30m lessThan tmp.n tmp.c
jump u30m strictEqual tmp.lnk null
ucontrol approach lx ly 6.5 0 0
ucontrol itemDrop tmp.lnk 999 0 0 0
sensor tmp.f @unit @firstItem
jump u30m strictEqual tmp.f null
jump u30e always
u30j:
ucontrol itemDrop @air 999 0 0 0
u30m:
jump u30e strictEqual ox null
ucontrol approach ox oy 6.5 0 0
ucontrol mine ox oy 0 0 0
jump u30e always
u30e:
u29:
ubind u29
sensor tmp.f @unit @firstItem
jump u29m strictEqual tmp.f null
jump u29j notEqual tmp.f cfg.item
sensor tmp.n @unit @totalItems
sensor tmp.c @unit @itemCapacity
jump u29m lessThan tmp.n tmp.c
