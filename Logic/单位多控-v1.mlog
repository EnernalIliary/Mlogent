ubind uty
sensor tmp.c @unit @controller
jump 50 strictEqual @unit null
jump 108 notEqual tmp.c @unit
set u5 @unit
ucontrol move @thisx @thisy 0 0 0
jump 50 always 0 0

jump 55 greaterThan 6 N
